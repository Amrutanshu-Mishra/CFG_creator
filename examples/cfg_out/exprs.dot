	14 [label="B14  L116\l 116: ifexp: v\l"]
	15 [label="B15  L116\l 116: ifexp → v\l"]
	16 [label="B16  L116\l 116: ifexp → 0\l"]
	17 [label="B17  L116\l 116: comp → k: v if v else 0\l"]
	18 [label="B18  L118\l 118: return y, pairs, lookup\l"]
	19 [label="B19  L117\l 117: raise AssertionError('positive')\l"]
