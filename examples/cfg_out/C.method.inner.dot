digraph "C.method.inner" {
	fontname=Helvetica fontsize=14 label="C.method.inner   N=3 E=2 M=1 (low)" labelloc=t
	node [fillcolor="#fafafa" fontname=Courier fontsize=10 shape=box style="rounded,filled"]
	edge [fontname=Helvetica fontsize=9]
	0 [label="ENTRY\ndef inner(z)" fillcolor="#c8e6c9" fontname=Helvetica shape=ellipse style="filled,bold"]
	1 [label=EXIT fillcolor="#ffcdd2" fontname=Helvetica shape=doublecircle style="filled,bold"]
	2 [label="B2  L75\l  75: return lambda q: q or z\l"]
	0 -> 2
	2 -> 1
}
