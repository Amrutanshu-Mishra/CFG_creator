digraph "C.method" {
	fontname=Helvetica fontsize=14 label="C.method   N=7 E=8 M=3 (low)" labelloc=t
	node [fillcolor="#fafafa" fontname=Courier fontsize=10 shape=box style="rounded,filled"]
	edge [fontname=Helvetica fontsize=9]
	0 [label="ENTRY\ndef method(self)" fillcolor="#c8e6c9" fontname=Helvetica shape=ellipse style="filled,bold"]
	1 [label=EXIT fillcolor="#ffcdd2" fontname=Helvetica shape=doublecircle style="filled,bold"]
	2 [label="B2  L74\l  74: def inner(z):\l"]
	3 [label="B3  L76\l  76: while True:\l"]
	4 [label="B4  L77\l  77: if self:\l"]
	5 [label="B5  L79\l  79: return inner\l"]
	6 [label="B6  L78\l  78: break\l"]
	0 -> 2
	2 -> 3
	3 -> 4 [label=T color="#2e7d32" fontcolor="#2e7d32"]
	3 -> 5 [label=F color="#c62828" fontcolor="#c62828"]
	4 -> 6 [label=T color="#2e7d32" fontcolor="#2e7d32"]
	4 -> 3 [label=F color="#c62828" fontcolor="#c62828"]
	6 -> 5 [label=break color="#1565c0" fontcolor="#1565c0" style=dashed]
	5 -> 1
}
